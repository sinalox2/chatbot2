# =============================================================================
# CONFIGURACIÓN PARA INTEGRACIÓN CHATWOOT + WHATSAPP BUSINESS (NUEVA ARQUITECTURA)
# =============================================================================

# OpenAI Configuration (Obligatorio)
OPENAI_API_KEY=sk-xxx

# Supabase Configuration (Obligatorio)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=eyJxxx

# Chatwoot API Configuration (Obligatorio para nueva arquitectura)
CHATWOOT_BASE_URL="https://chat.progreweb.com"
CHATWOOT_ACCOUNT_ID="4"
CHATWOOT_API_TOKEN="your-chatwoot-api-token"
CHATWOOT_INBOX_ID="35"

# Webhook verification (Opcional - solo si Chatwoot lo requiere)
WHATSAPP_VERIFY_TOKEN=nissan_verify_token

# =============================================================================
# VARIABLES DEPRECADAS (Ya no necesarias con integración Chatwoot)
# =============================================================================
# WHATSAPP_TOKEN=EAAxxxx  # Ya no necesario - Chatwoot maneja WhatsApp
# WHATSAPP_API_TOKEN=EAAxxxx  # Ya no necesario - Chatwoot maneja WhatsApp
# PHONE_NUMBER_ID=123456789  # Ya no necesario - Chatwoot maneja WhatsApp
# WHATSAPP_PHONE_NUMBER_ID=123456789  # Ya no necesario - Chatwoot maneja WhatsApp

# Flask Configuration
FLASK_PORT=5001
FLASK_HOST=0.0.0.0
DEBUG=False
FLASK_DEBUG=False
FLASK_ENV=production
PORT=5001

# Notification Configuration (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/xxx
DISCORD_WEBHOOK_URL=https://discord.com/xxx
TEAMS_WEBHOOK_URL=https://outlook.office.com/xxx

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
NOTIFICATION_EMAIL=notifications@company.com

# Business Configuration (Optional)
PRECIO_PROMEDIO_AUTO=350000
COMISION_PROMEDIO=0.05
COSTO_LEAD=50
META_DIARIA_LEADS=10